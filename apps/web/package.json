    "lint": "eslint \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
