{
  "name": "@easyerp/web",
  "version": "0.0.1",
  "description": "EasyERP frontend (Vue3 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
